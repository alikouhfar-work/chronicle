# Chronicle — production & preview env template (placeholders only, never real secrets).
# Copy the block you need into your hosting provider's env settings
# (e.g. Vercel project settings) or into an untracked local file.
#
#   production -> `.env.production` (untracked, gitignored)
#   preview    -> `.env.preview`    (untracked, gitignored)
#
# Generate secrets with: openssl rand -hex 32
# TMDB token: https://www.themoviedb.org/settings/api (API Read Access Token, v4 JWT)

# ─── PRODUCTION ──────────────────────────────────────────────────────────────
# App / runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
# Canonical public origin (share links, metadata). No trailing slash.
NEXT_PUBLIC_APP_URL=https://your-prod-domain.com

# Database (managed Postgres, e.g. Neon/Supabase/RDS)
PRISMA_TARGET=personal
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/chronicle
# Only needed if this deployment serves the demo DB (cron reset target)
DEMO_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/chronicle_demo

# TMDB (single server token — all users share it)
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_ACCESS_TOKEN=paste-tmdb-read-access-token-here
# Legacy fallback, optional — leave unset unless migrating old deploys
# DEMO_TMDB_TOKEN=

# Auth (NextAuth + mobile Bearer JWT)
AUTH_SECRET=paste-openssl-rand-hex-32-here
AUTH_TRUST_HOST=true
# Optional — omit both to disable Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Guest / demo account
GUEST_LOGIN_ENABLED=false
DEMO_USER_EMAIL=demo@chronicle.local

# Cron (protects GET /api/reset-demo; must match the CRON_SECRET cmakesecret)
CRON_SECRET=paste-openssl-rand-hex-32-here

# ─── PREVIEW ─────────────────────────────────────────────────────────────────
# Same keys as production, but pointed at preview resources. Suggested values:
#
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
# NEXT_PUBLIC_APP_URL=https://your-preview-url.vercel.app
#
# PRISMA_TARGET=personal
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/chronicle_preview
# DEMO_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/chronicle_demo
#
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# TMDB_ACCESS_TOKEN=paste-preview-tmdb-token-here
#
# AUTH_SECRET=paste-a-different-openssl-rand-hex-32-here
# AUTH_TRUST_HOST=true
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
#
# GUEST_LOGIN_ENABLED=true
# DEMO_USER_EMAIL=demo@chronicle.local
# CRON_SECRET=paste-preview-cron-secret-here

# ─── OBJECT STORAGE (comment image attachments) ──────────────────────────────
# Any S3-compatible bucket: AWS S3, Cloudflare R2, MinIO, Backblaze B2.
# When S3_BUCKET is unset, attachments are written to local disk
# (COMMENT_STORAGE_DIR, default .data/comment-uploads) — development only.
# S3_BUCKET=chronicle-comment-attachments
# S3_REGION=auto                                            # R2 uses "auto"
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com # omit for AWS S3
# S3_ACCESS_KEY_ID=paste-access-key-id
# S3_SECRET_ACCESS_KEY=paste-secret-access-key
# Public base for rendered image URLs (CDN or custom domain on the bucket).
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# Path-style addressing is required by MinIO and some S3-compatible providers.
# S3_FORCE_PATH_STYLE=false

# ─── LOCAL / SEED ONLY (not needed on prod/preview) ──────────────────────────
# Docker compose Postgres credentials (see docker-compose.yml)
# DATABASE_USER=admin
# DATABASE_PASSWORD=changeme
# DATABASE_DB=chronicle
# Seed script user (prisma/seed.ts; defaults to dev@chronicle.local)
# SEED_USER_EMAIL=dev@chronicle.local

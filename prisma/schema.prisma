generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShowTrackingStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  DROPPED
}

enum MovieTrackingStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
}

enum RewatchMediaType {
  EPISODE @map("episode")
  SEASON  @map("season")
  SHOW    @map("show")
  MOVIE   @map("movie")
}

enum CommentMediaType {
  EPISODE @map("episode")
  SHOW    @map("show")
  MOVIE   @map("movie")
}

enum NotificationType {
  COMMENT_MENTION @map("comment_mention")
}

model Show {
  id               String        @id @default(uuid())
  tmdbId           Int
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  overview         String        @db.Text
  posterPath       String?
  backdropPath     String?
  firstAirDate     DateTime?
  lastAirDate      DateTime?
  status           String
  tagline          String?
  numberOfSeasons  Int
  numberOfEpisodes Int
  inProduction     Boolean
  lastSyncedAt     DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  rewatchCount     Int           @default(0) @map("rewatch_count")
  seasons          Season[]
  genres           Genre[]
  tracking         ShowTracking?
  rewatchLogs      RewatchLog[]

  @@unique([userId, tmdbId])
  @@index([userId])
}

model Movie {
  id           String         @id @default(uuid())
  tmdbId       Int
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  overview     String         @db.Text
  posterPath   String?
  backdropPath String?
  releaseDate  DateTime?
  status       String
  runtime      Int
  tagline      String?
  lastSyncedAt DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  rewatchCount Int            @default(0) @map("rewatch_count")
  genres       Genre[]
  tracking     MovieTracking?
  rewatchLogs  RewatchLog[]

  @@unique([userId, tmdbId])
  @@index([userId])
}

model Season {
  id           String       @id @default(uuid())
  tmdbId       Int
  showId       String
  seasonNumber Int
  name         String
  episodeCount Int
  airDate      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  rewatchCount Int          @default(0) @map("rewatch_count")
  episodes     Episode[]
  rewatchLogs  RewatchLog[]

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([showId, seasonNumber])
  @@index([tmdbId])
}

model Episode {
  id            String           @id @default(uuid())
  tmdbId        Int
  seasonId      String
  episodeNumber Int
  name          String
  overview      String           @db.Text
  runtime       Int?
  airDate       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  rewatchCount  Int              @default(0) @map("rewatch_count")
  tracking      EpisodeTracking?
  rewatchLogs   RewatchLog[]

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, episodeNumber])
  @@index([tmdbId])
}

model Genre {
  id     String  @id @default(uuid())
  tmdbId Int     @unique
  name   String
  shows  Show[]
  movies Movie[]
}

model ShowTracking {
  id          String             @id @default(uuid())
  showId      String             @unique
  status      ShowTrackingStatus @default(PLAN_TO_WATCH)
  addedAt     DateTime           @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime           @updatedAt

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
}

model MovieTracking {
  id          String              @id @default(uuid())
  movieId     String              @unique
  status      MovieTrackingStatus @default(PLAN_TO_WATCH)
  rating      Int?
  notes       String?             @db.Text
  addedAt     DateTime            @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime            @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model EpisodeTracking {
  id        String    @id @default(uuid())
  episodeId String    @unique
  watched   Boolean   @default(false)
  watchedAt DateTime?
  rating    Int?
  notes     String?   @db.Text
  updatedAt DateTime  @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model User {
  id                    String           @id @default(cuid())
  name                  String?
  email                 String           @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  /// Lowercase handle used for @mentions: 3-32 chars, [a-z0-9_].
  username              String?          @unique
  accounts              Account[]
  sessions              Session[]
  shows                 Show[]
  movies                Movie[]
  rewatchLogs           RewatchLog[]
  comments        Comment[]
  mentions              CommentMention[] @relation("MentionsReceived")
  notificationsReceived Notification[]   @relation("NotificationsReceived")
  notificationsSent     Notification[]   @relation("NotificationsSent")
}

model RewatchLog {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  mediaType   RewatchMediaType @map("media_type")
  mediaId     String           @map("media_id")
  rewatchedAt DateTime         @default(now()) @map("rewatched_at")
  showId      String?          @map("show_id")
  seasonId    String?          @map("season_id")
  episodeId   String?          @map("episode_id")
  movieId     String?          @map("movie_id")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  show    Show?    @relation(fields: [showId], references: [id], onDelete: Cascade)
  season  Season?  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  movie   Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([userId, mediaType, mediaId, rewatchedAt])
  @@index([mediaType, mediaId])
  @@index([userId, rewatchedAt])
  @@index([showId])
  @@index([seasonId])
  @@index([episodeId])
  @@index([movieId])
  @@map("rewatch_logs")
}

model Comment {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  mediaType CommentMediaType @map("media_type")
  /// TMDB id of the reviewed title/episode. Public reviews are intentionally
  /// scoped by TMDB id (never the per-user internal row id) so every user's
  /// library shares the same conversation for the same media item.
  tmdbId    Int              @map("tmdb_id")
  content   String           @db.Text
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments   CommentAttachment[]
  mentions      CommentMention[]     @relation("CommentMentions")
  notifications Notification[]

  @@index([mediaType, tmdbId, createdAt])
  @@index([userId, createdAt])
  @@map("comments")
}

model CommentAttachment {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  url       String
  width     Int?
  height    Int?
  mimeType  String   @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("comment_attachments")
}

model CommentMention {
  id              String   @id @default(uuid())
  commentId       String   @map("comment_id")
  mentionedUserId String   @map("mentioned_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  comment Comment @relation("CommentMentions", fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User @relation("MentionsReceived", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId, createdAt])
  @@map("comment_mentions")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String           @map("recipient_id")
  actorId     String           @map("actor_id")
  type        NotificationType
  commentId   String           @map("comment_id")
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User          @relation("NotificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User          @relation("NotificationsSent", fields: [actorId], references: [id], onDelete: Cascade)
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@index([commentId])
  @@map("notifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

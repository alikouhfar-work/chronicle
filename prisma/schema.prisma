generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShowTrackingStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  DROPPED
}

enum MovieTrackingStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
}

model Show {
  id               String        @id @default(uuid())
  tmdbId           Int
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  overview         String        @db.Text
  posterPath       String?
  backdropPath     String?
  firstAirDate     DateTime?
  lastAirDate      DateTime?
  status           String
  tagline          String?
  numberOfSeasons  Int
  numberOfEpisodes Int
  inProduction     Boolean
  lastSyncedAt     DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  seasons          Season[]
  genres           Genre[]
  tracking         ShowTracking?

  @@unique([userId, tmdbId])
  @@index([userId])
}

model Movie {
  id           String         @id @default(uuid())
  tmdbId       Int
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  overview     String         @db.Text
  posterPath   String?
  backdropPath String?
  releaseDate  DateTime?
  status       String
  runtime      Int
  tagline      String?
  lastSyncedAt DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  genres       Genre[]
  tracking     MovieTracking?

  @@unique([userId, tmdbId])
  @@index([userId])
}

model Season {
  id           String    @id @default(uuid())
  tmdbId       Int       @unique
  showId       String
  seasonNumber Int
  name         String
  episodeCount Int
  airDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  episodes     Episode[]

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([showId, seasonNumber])
}

model Episode {
  id            String           @id @default(uuid())
  tmdbId        Int              @unique
  seasonId      String
  episodeNumber Int
  name          String
  overview      String           @db.Text
  runtime       Int?
  airDate       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tracking      EpisodeTracking?

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, episodeNumber])
}

model Genre {
  id     String  @id @default(uuid())
  tmdbId Int     @unique
  name   String
  shows  Show[]
  movies Movie[]
}

model ShowTracking {
  id          String             @id @default(uuid())
  showId      String             @unique
  status      ShowTrackingStatus @default(PLAN_TO_WATCH)
  addedAt     DateTime           @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime           @updatedAt

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
}

model MovieTracking {
  id          String              @id @default(uuid())
  movieId     String              @unique
  status      MovieTrackingStatus @default(PLAN_TO_WATCH)
  rating      Int?
  notes       String?             @db.Text
  addedAt     DateTime            @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime            @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model EpisodeTracking {
  id        String    @id @default(uuid())
  episodeId String    @unique
  watched   Boolean   @default(false)
  watchedAt DateTime?
  rating    Int?
  notes     String?   @db.Text
  updatedAt DateTime  @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String    @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  tmdbTokenCiphertext   String?   @db.Text
  tmdbTokenIv           String?
  tmdbTokenUpdatedAt    DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accounts              Account[]
  sessions              Session[]
  shows                 Show[]
  movies                Movie[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
